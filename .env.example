# ──────────────────────────────────────────
# Aegis — Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────

# === AI Agent ===
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=sk-your-groq-api-key-here

# === Ethereum RPC ===
# Sepolia testnet (default)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: Holesky and Mainnet RPCs
HOLESKY_RPC_URL=https://ethereum-holesky-rpc.publicnode.com
MAINNET_RPC_URL=https://eth.llamarpc.com

# === Ledger / Speculos ===
# Set to enable Speculos emulator mode (leave empty for hardware)
SPECULOS_HOST=
SPECULOS_APDU_PORT=9999
LEDGER_TIMEOUT=60000

# === Ledger Wallet CLI ===
# Path to the Ledger Wallet CLI binary
LEDGER_CLI_PATH=ledger-wallet
LEDGER_CLI_TIMEOUT=120000

# === Network ===
DEFAULT_NETWORK=sepolia
PORT=3001
FRONTEND_URL=http://localhost:3000

# === Security ===
# Max ETH allowed per transaction without special approval
MAX_DAILY_ETH=0.01