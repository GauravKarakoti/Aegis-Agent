{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "declaration": true,
    "resolveJsonModule": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "../lib/**/*.ts", "../agent/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}