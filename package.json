{
  "name": "aegis-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Personal AI wallet agent with Ledger hardware security",
  "scripts": {
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "typecheck": "cd backend && npx tsc --noEmit --skipLibCheck",
    "speculos": "chmod +x ./scripts/run-speculos.sh && bash ./scripts/run-speculos.sh --docker"
  },
  "dependencies": {
    "@ledgerhq/hw-app-eth": "^6.39.0",
    "@ledgerhq/hw-transport-http": "^6.30.2",
    "@ledgerhq/hw-transport-node-hid": "^6.30.2",
    "@ledgerhq/hw-transport-node-speculos": "^6.34.3",
    "ethers": "^6.13.5",
    "groq-sdk": "^1.2.1",
    "zod": "^3.24.1"
  }
}
